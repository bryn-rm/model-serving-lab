# GPU pilot pins and engine settings (Phase 4). No credentials belong here:
# LAB_UPSTREAM_API_KEY, LAB_GATEWAY_API_KEY and optional HF_TOKEN come from the
# shell environment. Read by deploy/compose.gpu.yaml (via --env-file), the
# Makefile and scripts/gpu-*.sh. Plain KEY=VALUE lines only (no quotes/spaces).
#
# Empty pins are filled on the GPU host by `scripts/gpu-preflight.sh --write`
# and then committed. Compose refuses to start while they are empty.

# Engine image. The digest pins what actually runs; the tag is for humans.
VLLM_IMAGE_REPO=vllm/vllm-openai
VLLM_IMAGE_TAG=v0.33.0
VLLM_IMAGE_DIGEST=

# Model. Tokenizer and chat template come from the same repository revision.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_REVISION=
SERVED_MODEL_NAME=lab-model

# Pilot scheduler defaults from BUILD_PLAN.md section 2. Freeze after the pilot.
DTYPE=auto
KV_CACHE_DTYPE=auto
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=4096
CHUNKED_PREFILL_FLAG=--enable-chunked-prefill
# Prefix caching is explicitly disabled for E1-E3/E5. The spelling differs by
# release; preflight checks the pinned image's help and rewrites this value.
PREFIX_CACHING_FLAG=--no-enable-prefix-caching
GENERATION_CONFIG=vllm

# Gateway. 0 disables admission (matched no-cap arm). Deadlines match the
# benchmark defaults: 120 s first text, 120 s idle, 300 s total.
LAB_ADMISSION_CAP=0
GATEWAY_FIRST_TEXT_TIMEOUT=120s
GATEWAY_IDLE_TIMEOUT=120s
GATEWAY_TOTAL_TIMEOUT=300s
GATEWAY_MAX_OUTPUT_TOKENS=4096
