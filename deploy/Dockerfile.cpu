FROM golang:1.27.3 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/mockllm ./cmd/mockllm && CGO_ENABLED=0 go build -o /out/gateway ./cmd/gateway
FROM scratch
COPY --from=build /out/mockllm /out/gateway /
COPY testdata/streams /testdata/streams
ENTRYPOINT ["/mockllm"]
CMD ["--addr", "0.0.0.0:8000"]
